<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>raptaboard: third-party licenses</title>
<style>
  body { font-family: sans-serif; max-width: 60em; margin: 2em auto; padding: 0 1em; }
  pre { white-space: pre-wrap; background: #f4f4f4; padding: 1em; }
  li { margin: 0.2em 0; }
</style>
</head>
<body>
<h1>Third-party licenses</h1>
<p>raptaboard is built from these open-source crates. Their licenses follow,
each with the crates under it. raptaboard's own license is in LICENSE.txt.</p>
<h2>Licenses used</h2>
<ul>
{{#each overview}}
  <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
{{#each licenses}}
<h2 id="{{id}}">{{name}}</h2>
<p>Used by:</p>
<ul>
{{#each used_by}}
  <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
{{/each}}
</ul>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
