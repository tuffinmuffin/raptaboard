// raptaboard plugin interface (host API 0.2, a draft: nothing runs it yet).
//
// A widget plugin is a WebAssembly component that exports the `widget` world.
// The dashboard makes one instance per widget and runs it on a thread of its
// own, so a slow plugin never holds up the window:
//
// 1. `subscriptions` says which values the widget wants. It's asked again
//    whenever one of the widget's properties changes.
// 2. `update` gets every change to those values since the last call, oldest
//    first. The first call has each topic's current value.
// 3. `render` returns the picture: shapes in widget-local pixels (0,0 is the
//    top-left corner, y grows down) and the clickable regions. The window
//    draws the newest picture the plugin has finished.
// 4. `on-input` gets clicks, pointer moves and, while the widget has focus,
//    keys.
//
// Plugins can't open files, sockets or windows. Everything outside the plugin
// goes through `host`, and some of it needs a permission in plugin.toml, which
// the user sees before installing the pack.
//
// This version is for widgets on the grid, enough to remake the built-in Text
// Display and Alerts as plugins. Tabs, pixels, audio streams, UI elements and
// 3D scenes come in later versions: see docs/spec.md "Plugin system".

package raptaboard:dashboard@0.2.0;

interface types {
    /// A plain NetworkTables value.
    variant scalar-value {
        boolean(bool),
        int(s64),
        double(f64),
        str(string),
        bool-array(list<bool>),
        int-array(list<s64>),
        double-array(list<f64>),
        str-array(list<string>),
    }

    /// One field of a decoded struct. WIT types can't nest themselves, so nested
    /// structs are flattened with dotted names: a Pose2d arrives as
    /// "translation.x", "translation.y" and "rotation.value".
    record field {
        name: string,
        value: scalar-value,
    }

    /// A value read from NetworkTables. Struct topics arrive decoded as records.
    variant nt-value {
        boolean(bool),
        int(s64),
        double(f64),
        str(string),
        bool-array(list<bool>),
        int-array(list<s64>),
        double-array(list<f64>),
        str-array(list<string>),
        %record(list<field>),
    }

    /// Which values a widget wants pushed to `update`.
    variant subscription {
        /// A key under the bound table, like "angle_rad" or "Module/0/speed".
        key(string),
        /// Every key under the bound table, at any depth.
        all-keys,
        /// Every table on the server whose `.type` is this, like "Alerts",
        /// with all its keys, including tables that appear later. Topics
        /// arrive by their full path ("/SmartDashboard/Intake/errors").
        tables-of-type(string),
    }

    /// One change to a value the widget subscribed to.
    record sample {
        /// The key under the bound table ("angle_rad"), or the full path
        /// (starting with "/") for a `tables-of-type` subscription.
        topic: string,
        /// The new value; `none` when the topic stopped being published.
        value: option<nt-value>,
        /// When the server says the value changed, in microseconds.
        time-us: s64,
    }

    record point { x: f32, y: f32 }
    record size { width: f32, height: f32 }

    /// RGBA, 0-255 each.
    record color { r: u8, g: u8, b: u8, a: u8 }

    record stroke { width: f32, color: color }

    record line { start: point, end: point, stroke: stroke }
    record polyline { points: list<point>, closed: bool, stroke: stroke, fill: option<color> }
    /// Angles in radians, counter-clockwise from +x as seen on screen.
    record arc { center: point, radius: f32, start-rad: f32, end-rad: f32, stroke: stroke }
    record rect { min: point, max: point, corner-radius: f32, stroke: option<stroke>, fill: option<color> }
    record circle { center: point, radius: f32, stroke: option<stroke>, fill: option<color> }

    enum align { left, center, right }
    /// Text in the dashboard's font. With `max-width` it wraps onto more lines
    /// at that width (`host.measure-text` says how tall it gets).
    record text {
        pos: point,
        text: string,
        size: f32,
        color: color,
        align: align,
        max-width: option<f32>,
        monospace: bool,
    }

    /// An image from the plugin's own folder, like "arm.png".
    record image { path: string, min: point, max: point }

    variant shape {
        line(line),
        polyline(polyline),
        arc(arc),
        rect(rect),
        circle(circle),
        text(text),
        image(image),
    }

    /// What a region is, for screen readers and tests.
    enum role { button, toggle, label }

    /// A part of the widget that can be clicked, tapped or reached with the
    /// keyboard. The dashboard makes each one an accessible control with this
    /// label (tests find them by it) and sends `activate` when it's used.
    record region {
        /// The plugin's own name for it, sent back in `activate`.
        id: string,
        min: point,
        max: point,
        label: string,
        role: role,
        /// On or off, for a toggle.
        checked: option<bool>,
    }

    /// The dashboard's current colors, so a plugin matches light and dark themes.
    record theme {
        dark: bool,
        text: color,
        weak-text: color,
        background: color,
        card: color,
        accent: color,
        error: color,
        warning: color,
        info: color,
    }

    /// Everything about this frame besides the values.
    record frame-info {
        size: size,
        /// Seconds since the widget was created.
        time-s: f64,
        /// Whether the dashboard is connected to the server now.
        connected: bool,
        /// Whether the layout is locked (input covers the whole widget).
        locked: bool,
        theme: theme,
    }

    /// One frame's drawing.
    record picture {
        shapes: list<shape>,
        regions: list<region>,
        /// Draw again after this many seconds even if nothing changes (an
        /// animation or a pulse). `none`: only when a value, the size or the
        /// theme changes, or after input.
        redraw-in-s: option<f64>,
        /// What a screen reader says for the whole widget, like "2 errors".
        summary: option<string>,
    }

    /// How urgent a widget's state is, for the mark on its tab.
    enum level { info, warning, error }

    flags modifiers { shift, ctrl, alt, command }

    /// A key by egui's name for it: "A", "Num1", "ArrowUp", "Space", "Escape".
    record key {
        name: string,
        modifiers: modifiers,
    }

    variant input {
        /// A region was clicked, tapped, or used from the keyboard.
        activate(string),
        pointer-down(point),
        pointer-up(point),
        pointer-move(point),
        /// The scroll wheel or a two-finger scroll, in pixels.
        wheel(point),
        /// The widget got focus (clicked into) or lost it (Escape, or a click
        /// elsewhere). Keys and text only come while it has focus, and the
        /// dashboard's own shortcuts are off meanwhile.
        focus(bool),
        key-down(key),
        key-up(key),
        /// Typed text, after the keyboard layout and any compose keys.
        text(string),
    }
}

interface host {
    use types.{nt-value, size};

    /// Latest value of a key the widget subscribed to: relative to the bound
    /// table ("angle_rad"), or a full path from a `tables-of-type` subscription.
    get: func(topic: string) -> option<nt-value>;
    /// The key's `unit` topic property, like "rad" or "m", if the robot set one.
    unit: func(topic: string) -> option<string>;
    /// Write a value under the bound table. Needs `publish = true` in plugin.toml.
    publish: func(key: string, value: nt-value) -> result<_, string>;
    /// A widget property set in the edit dialog (declared in plugin.toml). A
    /// `sound` property gives its choice as a string, ready for `play-sound`.
    property: func(name: string) -> option<nt-value>;
    /// How big text would be drawn: one line, or wrapped at `max-width`.
    measure-text: func(text: string, size: f32, max-width: option<f32>, monospace: bool) -> size;
    /// Play a sound: a `sound` property's value (a built-in tone or clip, or
    /// an installed pack's). Muted when the dashboard's sound is off. Needs
    /// `sound = true` in plugin.toml.
    play-sound: func(sound: string) -> result<_, string>;
    /// Write a line to the dashboard log.
    log: func(message: string);
}

world widget {
    import host;
    use types.{subscription, sample, frame-info, picture, input, level};

    /// The values this widget wants pushed to `update`.
    export subscriptions: func() -> list<subscription>;
    /// Changes since the last call, oldest first.
    export update: func(samples: list<sample>);
    /// Draw the widget.
    export render: func(frame: frame-info) -> picture;
    /// The mark for the widget's tab, asked after each `update`, also while
    /// the tab is closed when plugin.toml has `background = true`.
    export tab-mark: func() -> option<level>;
    /// Input inside the widget.
    export on-input: func(event: input);
}
